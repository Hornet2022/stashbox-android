<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      dev 环境允许明文 HTTP。
      prod 默认不允许（base-config cleartextTrafficPermitted=false）。

      CP-ANDROID-MDNS：客户端改用 mDNS 主机名 `Mac-mini.local`（不随 DHCP 变化）
      后，**必须把它加进明文白名单**，否则 Android 会直接拦掉所有明文请求
      ——症状是 App 能编译能装，但一个接口都调不通（且报错只在运行时出现，
      编译期和单测都发现不了）。

      保留历史 IP 是为了兼容：设备上若还跑着旧版本 APK，或用 adb 直连调试。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!--
          mDNS 主机名：真机访问宿主 Mac mini 的稳定地址。
          ⚠️ 只能写这一行，且写全小写。
          XmlConfigSource.parseDomain() 会把 domain 转小写后查重，
          同一个域名大小写各写一遍会被判为 "xxx has already been specified"，
          抛 ParserException → NetworkSecurityConfigProvider 初始化失败 →
          Application 构造时直接崩（启动就退，不是网络问题）。
          所以这里写 mac-mini.local 即可，请求时用 Mac-mini.local 也能匹配上。
        -->
        <domain includeSubdomains="true">mac-mini.local</domain>
        <!-- 历史局域网 IP（172.16.5.28 / en8 USB 网卡），保留兼容旧包与直连调试 -->
        <domain includeSubdomains="true">172.16.5.28</domain>
        <domain includeSubdomains="true">172.16.1.90</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <!-- prod 默认不允许明文 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
