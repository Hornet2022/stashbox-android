<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      dev 环境允许明文 HTTP。
      prod 默认不允许（base-config cleartextTrafficPermitted=false）。

      CP-ANDROID-MDNS：客户端改用 mDNS 主机名 `Mac-mini.local`（不随 DHCP 变化）
      后，**必须把它加进明文白名单**，否则 Android 会直接拦掉所有明文请求
      ——症状是 App 能编译能装，但一个接口都调不通（且报错只在运行时出现，
      编译期和单测都发现不了）。

      保留历史 IP 是为了兼容：设备上若还跑着旧版本 APK，或用 adb 直连调试。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!--
          mDNS 主机名：真机访问宿主 Mac mini 的稳定地址。
          ⚠️ 只能写这一行，且写全小写。
          XmlConfigSource.parseDomain() 会把 domain 转小写后查重，
          同一个域名大小写各写一遍会被判为 "xxx has already been specified"，
          抛 ParserException → NetworkSecurityConfigProvider 初始化失败 →
          Application 构造时直接崩（启动就退，不是网络问题）。
          所以这里写 mac-mini.local 即可，请求时用 Mac-mini.local 也能匹配上。
        -->
        <domain includeSubdomains="true">mac-mini.local</domain>
        <!--
          局域网 IP：真机（华为 JEF-AN20）实测解析不了 mac-mini.local，
          客户端的 OkHttp 有 MdnsFallbackDns 能把 mDNS 兜底到 IP，
          但**音频走 ExoPlayer 自己的 DefaultHttpDataSource，它不走那个 Dns**，
          直接拿 audio_url 里的 host 去连 —— 所以 audio_url 用 IP 时，
          这个 IP 必须在明文白名单里，否则报
          `IOException: Cleartext HTTP traffic to <ip> not permitted`
          （症状：详情页渲染正常、一按播放就 ExoPlaybackException: Source error）。
        -->
        <domain includeSubdomains="true">192.168.3.100</domain>
        <!-- 历史局域网 IP（172.16.5.28 / en8 USB 网卡、172.16.1.90），保留兼容旧包与直连调试 -->
        <domain includeSubdomains="true">172.16.5.28</domain>
        <domain includeSubdomains="true">172.16.1.90</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!--
          IPv4 回环：⚠️ 必须和上面的 localhost **分开写**。
          NetworkSecurityConfig 按 **hostname 字符串**匹配，不是按解析出来的 IP ——
          `localhost` 与 `127.0.0.1` 是两个不同的 host，白名单里有前者**不覆盖**
          后者。

          漏掉它的后果是本文件开头警告的那种静默失败，且专门坑 `adb reverse`：
          调试时最自然的写法就是 `-PapiBaseUrl=http://127.0.0.1:18100/`
          （adb reverse 把设备回环端口转到宿主），于是 App 能编译、能装、能进主界面，
          但每个请求都被拦掉：

            java.net.UnknownServiceException: CLEARTEXT communication to 127.0.0.1
            not permitted by network security policy

          症状具有欺骗性：界面渲染完全正常（只是「暂无文章」），ViewModel 走
          soft-fail 只打一条 warn，于是**没有任何崩溃、没有红字**，第一反应会是
          「后端没起」或「App 连不上」，而真正的原因是一个 XML 里少了一行。
        -->
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <!-- prod 默认不允许明文 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
