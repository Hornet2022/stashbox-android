<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      2026-10-21：应用内更新要能装 APK。

      REQUEST_INSTALL_PACKAGES 是 Android 8+ 的"安装未知来源应用"权限。
      没有它，下载好的 APK 装不了（系统直接拒绝跳转安装器）。

      ⚠️ 这个权限在应用商店上架时会被审核关注（能装任意 APK）。
      内测阶段是必要的 —— 没有它，测试员只能自己去浏览器下载 APK，
      "应用内更新"就只剩个提示作用。
      正式上架前要评估：可以改成引导用户去应用商店更新（那时就不需要这个权限）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".TingxiaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tingxia"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <!--
          预测性返回手势（2026-10-27，Material 3 指南 R2.10）。

          Android 13（API 33）起，系统返回手势支持**预测式**动画：手指滑动时
          目标页面会跟着缩小/位移，抬手才真正完成返回。

          ⚠️ 本项目 targetSdk=35 ⇒ 预测性返回**本来就是默认开启的**
          （`android:enableOnBackInvokedCallback` 对 targetSdk≥33 的应用默认为 true），
          所以这里写 `true` 是**显式声明现状**而不是"打开某个开关"。

          为什么要显式写出来：默认值是**隐式**的 —— 将来若有人把 targetSdk 降到 33
          以下、或误写成 false，行为会静默变回"一下就跳走"（无预览动画）。
          写出来 + 注释，是为了让"返回手势有动画"成为**可审查的约定**而不是运气。

          App 内没有任何自定义 onBackPressed 覆写，返回由 NavController /
          Compose BackHandler 接管，二者都已支持预测式返回。
        -->

        <!--
          关掉 WorkManager 的默认初始化（2026-10-02）。
          TingxiaApp 实现了 Configuration.Provider 提供带 Hilt 的 Configuration，
          若不禁用默认初始化，WorkManager 会抢先用无 Hilt 的配置自建实例，
          我们的 HiltWorkerFactory 不会生效 —— 表现为 Worker 注入字段全 null。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          2026-10-21：FileProvider —— 应用内更新下载完 APK 后要把它交给系统安装器。

          为什么必须用 FileProvider：Android 7+ 不允许跨应用传 file:// Uri
          （FileUriExposedException），只能传 content:// Uri，
          而 content:// Uri 要靠 FileProvider 把文件路径映射出来。
          路径映射写在 res/xml/file_paths.xml。

          ⚠️ authorities 用 ${applicationId}.fileprovider —— 带 applicationId 是必须的，
          debug 包（.debug）和 release 包（无后缀）authority 不同，否则会串。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tingxia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- CP10.9 D9: 接 微信/抖音/浏览器 分享 (ACTION_SEND + EXTRA_TEXT 含 URL) -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- CP10.9 D9: 接 浏览器直链打开 (https://stashbox.app/?url=...) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- CP10.9 D9: 自定义 scheme tingxia://add?url=... 调试用 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tingxia" android:host="add" />
            </intent-filter>

            <!-- CP3.7.0 测试: stashbox://detail/{id} 深链跳详情页(e2e 验收用) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stashbox" android:host="detail" />
            </intent-filter>
        </activity>

        <!-- CP4.4 后台播放：MediaSessionService + ExoPlayer + MediaSession -->
        <service
            android:name=".audio.AudioPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Robolectric 本地 Compose UI 单测（createComposeRule 会启动 ComponentActivity）需要该 activity 在 manifest 中注册，否则 resolve 失败 -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false" />

    </application>

</manifest>
